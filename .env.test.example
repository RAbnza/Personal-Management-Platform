# PostgreSQL administrator connection used only to create and provision the
# isolated local integration-test database.
TEST_DATABASE_ADMIN_URL=postgresql://postgres:local-development-only@127.0.0.1:5433/postgres

# Integration-test migration credential.
DATABASE_MIGRATION_URL=postgresql://migration_owner:local-migration-owner-2026-only@127.0.0.1:5433/personal_management_test

# Integration-test runtime credentials.
DATABASE_URL=postgresql://app_domain:local-app-domain-2026-only@127.0.0.1:5433/personal_management_test
AUTH_DATABASE_URL=postgresql://auth_adapter:local-auth-adapter-2026-only@127.0.0.1:5433/personal_management_test