# Separate worker credentials. Never add queue/operator secrets to the web service.
QUEUE_DATABASE_URL=postgresql://queue_broker:local-queue-broker-2026-only@127.0.0.1:5433/personal_management
AUTH_DATABASE_URL=postgresql://auth_adapter:local-auth-adapter-2026-only@127.0.0.1:5433/personal_management
LIFECYCLE_DATABASE_URL=postgresql://lifecycle_operator:local-lifecycle-operator-2026-only@127.0.0.1:5433/personal_management
# A restored worker must remain paused until the restore runbook is completed.
WORKER_PAUSED=true
LIFECYCLE_AUTOMATION_ENABLED=false
# Enable lifecycle automation only after independent S3/KMS and retention gates.
# Worker IAM permits conditional PutObject/GetObject on v1-deletion-register/*.
# BACKUP_S3_BUCKET=private-independent-bucket
# BACKUP_S3_REGION=ap-southeast-1
# BACKUP_S3_KMS_KEY_ID=independently-recoverable-key-id
EMAIL_PAYLOAD_KEY=replace-with-64-hex-characters-from-an-independent-32-byte-secret
EMAIL_PAYLOAD_KEY_ID=v1
EMAIL_PROVIDER=mailpit
EMAIL_FROM_ADDRESS=no-reply@example.test
EMAIL_FROM_NAME=Personal Management App
MAILPIT_API_URL=http://127.0.0.1:8025
