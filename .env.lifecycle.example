# Separate operator process only. Never add this credential to the web runtime.
LIFECYCLE_DATABASE_URL=postgresql://lifecycle_operator:replace-with-operator-password@localhost:5432/personal_management
# Required explicit environment. Deployed purge requires independent S3/KMS
# checkpoint publication/readback before every step and sslmode=verify-full.
PMP_DEPLOYMENT_ENV=local
# BACKUP_S3_BUCKET=private-independent-bucket
# BACKUP_S3_REGION=ap-southeast-1
# BACKUP_S3_KMS_KEY_ID=independently-recoverable-key-id
