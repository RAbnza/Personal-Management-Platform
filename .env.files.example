# V2-H files: disabled until dedicated storage/scanner operational acceptance.
# Separate from BACKUP_S3, authentication, migration and lifecycle identities.
FILES_STORAGE_ENABLED=false
FILES_S3_BUCKET=
FILES_S3_REGION=
FILES_S3_ENDPOINT=
FILES_S3_ACCESS_KEY_ID=
FILES_S3_SECRET_ACCESS_KEY=
# Private isolated clamd network; updated signatures within 48 hours.
FILES_SCAN_ENABLED=false
FILES_CLAMD_HOST=
FILES_CLAMD_PORT=3310
FILES_CLAMD_TIMEZONE=UTC
# File worker: restricted worker_domain role only.
FILES_ENABLED=false
FILES_DATABASE_URL=
# FILES_TEST_ADAPTER_DIR is synthetic local testing only; never set in staging/production.
