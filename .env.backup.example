# Controlled scheduled operator only. Never pass to web/email runtime.
PMP_DEPLOYMENT_ENV=production
BACKUP_DATABASE_URL=postgresql://pmp_backup:replace-secret@private-db.example:5432/personal_management?sslmode=verify-full
PGSSLROOTCERT=/run/secrets/postgres-ca.pem
BACKUP_ENCRYPTION_KEY=replace-with-independent-64-hex-character-key
BACKUP_ENCRYPTION_KEY_ID=backup-v1
BACKUP_S3_BUCKET=replace-private-independent-bucket
BACKUP_S3_REGION=ap-southeast-1
BACKUP_S3_KMS_KEY_ID=replace-key-arn
# Supply dedicated AWS identity through the platform secret/identity mechanism.
# Store recovery keys separately. Validate actual 30-day lifecycle and PITR.
