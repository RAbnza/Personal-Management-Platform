{
  "name": "personal-management-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "jobs:migrate": "tsx scripts/jobs/migrate.ts",
    "jobs:migrate:test": "tsx scripts/jobs/migrate.ts --test",
    "worker": "tsx scripts/jobs/worker.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config=vitest.integration.config.ts",
    "test:browser": "playwright test",
    "services:up": "docker compose --env-file .env.docker up -d",
    "services:down": "docker compose --env-file .env.docker down",
    "services:logs": "docker compose --env-file .env.docker logs -f",
    "email:check": "tsx scripts/email/check-delivery.ts",
    "db:check:bootstrap": "tsx scripts/db/check-bootstrap-connection.ts",
    "db:check:runtime": "tsx scripts/db/check-runtime-connections.ts",
    "db:provision:roles": "tsx scripts/db/provision-roles.ts",
    "db:setup:test": "tsx scripts/db/setup-test-database.ts",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "db:migrate:test": "drizzle-kit migrate --config=drizzle.test.config.ts",
    "db:verify:chain": "tsx scripts/db/verify-migration-chain.ts",
    "lifecycle:purge": "tsx scripts/lifecycle/purge.ts",
    "lifecycle:register": "tsx scripts/lifecycle/export-deletion-register.ts",
    "auth:housekeeping": "tsx scripts/lifecycle/auth-housekeeping.ts",
    "auth:schema:generate": "auth generate --config ./src/platform/auth/schema-generation.ts --output ./src/platform/db/schema/auth.generated.ts --yes",
    "backup:daily": "tsx scripts/backup/daily.ts",
    "verify:restore": "tsx scripts/testing/restore-drill.ts",
    "verify:containers": "tsx scripts/testing/container-smoke.ts",
    "verify:performance": "tsx scripts/testing/performance.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1140.0",
    "@better-auth/drizzle-adapter": "1.7.7",
    "@date-fns/tz": "1.5.0",
    "@hookform/resolvers": "5.9.1",
    "@radix-ui/react-dialog": "1.1.23",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "csv-stringify": "6.9.0",
    "drizzle-orm": "0.45.3",
    "lucide-react": "1.52.0",
    "next": "16.3.8",
    "next-themes": "0.4.6",
    "pg": "8.23.1",
    "pg-boss": "12.36.0",
    "pino": "10.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.89.0",
    "recharts": "3.10.1",
    "resend": "6.32.0",
    "tailwind-merge": "3.7.0",
    "tsx": "4.23.15",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^24",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "auth": "1.7.7",
    "csv-parse": "7.0.3",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.0.0",
    "prettier": "3.9.9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@12.9.1"
}
