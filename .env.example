# Normal Next.js application runtime.
PMP_DEPLOYMENT_ENV=local
# Generate an independent 32-byte random key, encoded as 64 hex characters.
# Use the SAME active key/key ID in the web and security-email worker only.
# EMAIL_PAYLOAD_KEY=replace-with-64-hex-characters-from-an-independent-32-byte-secret
EMAIL_PAYLOAD_KEY_ID=v1
#
# DATABASE_URL is restricted to private domain data.
# AUTH_DATABASE_URL is restricted to Better Auth-owned data.
#
# These are local development credentials only. Production must use
# independently generated secrets.
DATABASE_URL=postgresql://app_domain:local-app-domain-2026-only@127.0.0.1:5433/personal_management
AUTH_DATABASE_URL=postgresql://auth_adapter:local-auth-adapter-2026-only@127.0.0.1:5433/personal_management

# Better Auth
#
# The local value is intentionally development-only. Production must use a
# separately generated high-entropy secret of at least 32 characters.
BETTER_AUTH_SECRET=local-development-better-auth-secret-2026-only
BETTER_AUTH_URL=http://localhost:3000

# Email delivery
#
# Local development uses Mailpit. Production should use "resend" together with
# a real Resend API key and a verified sender address/domain.
EMAIL_PROVIDER=mailpit
EMAIL_FROM_ADDRESS=no-reply@example.test
EMAIL_FROM_NAME=Personal Management App
MAILPIT_API_URL=http://127.0.0.1:8025

# Production example only:
# EMAIL_PROVIDER=resend
# EMAIL_FROM_ADDRESS=no-reply@your-verified-domain.example
# EMAIL_FROM_NAME=Your Product Name
# RESEND_API_KEY=re_replace_with_production_secret

# Optional support draft destination, visible in Help.
# SUPPORT_EMAIL=support@example.test
