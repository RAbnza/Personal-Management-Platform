# Normal Next.js application runtime.
#
# DATABASE_URL is restricted to private domain data.
# AUTH_DATABASE_URL is restricted to Better Auth-owned data.
#
# These are local development credentials only. Production must use
# independently generated secrets.
DATABASE_URL=postgresql://app_domain:local-app-domain-2026-only@127.0.0.1:5433/personal_management
AUTH_DATABASE_URL=postgresql://auth_adapter:local-auth-adapter-2026-only@127.0.0.1:5433/personal_management