# Local-only PostgreSQL bootstrap administrator.
#
# Used only to provision database roles and other deployment-level database
# infrastructure. Never load this file from the normal application runtime.
DATABASE_BOOTSTRAP_URL=postgresql://postgres:local-development-only@127.0.0.1:5433/personal_management

# Local development passwords for the database roles created by the bootstrap
# provisioning script. Production must use independently generated secrets.
MIGRATION_OWNER_PASSWORD=local-migration-owner-2026-only
APP_DOMAIN_PASSWORD=local-app-domain-2026-only
AUTH_ADAPTER_PASSWORD=local-auth-adapter-2026-only
QUEUE_BROKER_PASSWORD=local-queue-broker-2026-only
WORKER_DOMAIN_PASSWORD=local-worker-domain-2026-only
LIFECYCLE_OPERATOR_PASSWORD=local-lifecycle-operator-2026-only